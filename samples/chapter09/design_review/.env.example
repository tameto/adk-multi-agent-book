# Google AI Studio / Gemini API route for local hands-on.
# Set GOOGLE_API_KEY in your shell or replace the placeholder below locally.
GOOGLE_API_KEY=your-api-key-here
GOOGLE_GENAI_USE_VERTEXAI=FALSE

# Vertex AI route. Uncomment all of these only when using ADC/GCP auth.
# GOOGLE_GENAI_USE_VERTEXAI=TRUE
# GOOGLE_CLOUD_PROJECT=your-project-id
# GOOGLE_CLOUD_LOCATION=us-central1

# レビュー対象のベースディレクトリ（パストラバーサル対策）
REVIEW_BASE_DIR=.
