# Google AI Studio / Vertex AI の APIキー
# https://aistudio.google.com/apikey から取得してください
GOOGLE_API_KEY=your-api-key-here

# 実行環境（dev / staging / prod）
AGENT_ENV=dev

# Memory Bankの有効化（true / false）
ENABLE_MEMORY_BANK=false

# Vertex AI を使用する場合（staging / prod）
# GCP_PROJECT=your-project-id
# GCP_LOCATION=us-central1

# DatabaseSessionService用（staging）
# DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agent_db

# RAG Engine用（オプション）
# RAG_CORPUS_ID=your-corpus-id
